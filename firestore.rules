rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function validPerson() {
      let data = request.resource.data;
      return data.keys().hasAll(['name', 'status', 'ownerUid'])
        && data.keys().hasOnly(['name', 'status', 'ownerUid', 'createdAt', 'updatedAt'])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 120
        && data.status in ['invited', 'committed', 'interested']
        && data.ownerUid == request.auth.uid
        && data.get('createdAt', request.time) is timestamp
        && data.get('updatedAt', request.time) is timestamp;
    }

    match /Trips/indonesia-2027/people/{personId} {
      allow read: if signedIn();
      allow create: if signedIn() && validPerson();
      allow update: if signedIn()
        && personId == request.auth.uid
        && resource.data.ownerUid == request.auth.uid
        && validPerson()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'status', 'updatedAt']);

      match /private/travel {
        function ownsTravel() {
          return signedIn() && personId == request.auth.uid
            && get(/databases/$(database)/documents/Trips/indonesia-2027/people/$(personId)).data.ownerUid == request.auth.uid;
        }
        function validTravel() {
          let data = request.resource.data;
          return data.keys().hasAll(['city', 'departureAirports', 'updatedAt'])
            && data.keys().hasOnly(['city', 'departureAirports', 'updatedAt'])
            && data.city is string && data.city.trim().size() > 0 && data.city.size() <= 120
            && data.departureAirports is list && data.departureAirports.size() > 0 && data.departureAirports.size() <= 20
            && data.departureAirports.join(',').matches('^[A-Z]{3}(,[A-Z]{3}){0,19}$')
            && data.departureAirports.toSet().size() == data.departureAirports.size()
            && data.updatedAt == request.time;
        }
        allow read: if ownsTravel();
        allow create, update: if ownsTravel() && validTravel();
      }

      match /private/contact {
        function ownsPerson() {
          return signedIn()
            && get(/databases/$(database)/documents/Trips/indonesia-2027/people/$(personId)).data.ownerUid == request.auth.uid;
        }
        allow read: if ownsPerson();
        allow update: if ownsPerson()
          && personId == request.auth.uid
          && request.resource.data.keys().hasOnly(['phone', 'email'])
          && request.resource.data.get('phone', '') is string
          && request.resource.data.get('phone', '').size() <= 40
          && request.resource.data.get('email', '') is string
          && request.resource.data.get('email', '').size() <= 254;
        allow create: if signedIn()
          && getAfter(/databases/$(database)/documents/Trips/indonesia-2027/people/$(personId)).data.ownerUid == request.auth.uid
          && request.resource.data.keys().hasOnly(['phone', 'email'])
          && request.resource.data.keys().size() > 0
          && request.resource.data.get('phone', '') is string
          && request.resource.data.get('phone', '').size() <= 40
          && request.resource.data.get('email', '') is string
          && request.resource.data.get('email', '').size() <= 254;
      }
    }

    // Shared fare snapshots contain travel details only; guests may view them.
    match /Trips/indonesia-2027/flights/{flightId} {
      function validStop(leg, index) {
        return leg.stops.size() <= index || (leg.stops[index] is string && leg.stops[index].matches('^[A-Z]{3}$'));
      }
      function validLeg(leg) {
        return leg is map
          && leg.keys().hasAll(['origin', 'destination', 'originCity', 'destinationCity', 'departureTime', 'arrivalTime', 'departureDate', 'arrivalDate', 'duration', 'stops'])
          && leg.keys().hasOnly(['origin', 'destination', 'originCity', 'destinationCity', 'departureTime', 'arrivalTime', 'departureDate', 'arrivalDate', 'duration', 'stops'])
          && leg.origin is string && leg.origin.matches('^([A-Z]{3})?$')
          && leg.destination is string && leg.destination.matches('^([A-Z]{3})?$')
          && leg.originCity is string && leg.originCity.size() <= 120
          && leg.destinationCity is string && leg.destinationCity.size() <= 120
          && leg.departureTime is string && leg.departureTime.size() <= 30
          && leg.arrivalTime is string && leg.arrivalTime.size() <= 30
          && leg.departureDate is string && (leg.departureDate == '' || leg.departureDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
          && leg.arrivalDate is string && (leg.arrivalDate == '' || leg.arrivalDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
          && leg.duration is string && leg.duration.size() <= 80
          && leg.stops is list && leg.stops.size() <= 6
          && validStop(leg, 0) && validStop(leg, 1) && validStop(leg, 2)
          && validStop(leg, 3) && validStop(leg, 4) && validStop(leg, 5);
      }
      function validItinerary(data) {
        let legs = data.get('legs', []);
        return legs is list && legs.size() <= 2
          && (legs.size() == 0 || validLeg(legs[0]))
          && (legs.size() < 2 || validLeg(legs[1]))
          && data.get('fareSummary', '') is string && data.get('fareSummary', '').size() <= 240;
      }
      function validFlight() {
        let data = request.resource.data;
        return data.keys().hasAll(['origin', 'destination', 'departure', 'returnDate', 'airline', 'flightNumbers', 'price', 'currency', 'link', 'notes', 'ownerUid', 'savedAt'])
          && data.keys().hasOnly(['origin', 'destination', 'departure', 'returnDate', 'airline', 'flightNumbers', 'price', 'currency', 'link', 'notes', 'ownerUid', 'savedAt', 'legs', 'fareSummary'])
          && data.origin is string && data.origin.matches('^[A-Z]{3}$')
          && data.destination is string && data.destination.matches('^[A-Z]{3}$')
          && data.origin != data.destination
          && data.departure is string && data.departure.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && data.returnDate is string
          && (data.returnDate == '' || (data.returnDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && data.returnDate >= data.departure))
          && data.airline is string && data.airline.size() > 0 && data.airline.size() <= 120
          && data.flightNumbers is string && data.flightNumbers.size() <= 120
          && data.price is number && data.price > 0 && data.price <= 1000000
          && data.currency is string && data.currency.matches('^[A-Z]{3}$')
          && data.link is string && data.link.size() <= 2000
          && (data.link == '' || data.link.matches('^https://[^\\s]+$'))
          && data.notes is string && data.notes.size() <= 2000
          && data.ownerUid == request.auth.uid
          && data.savedAt == request.time
          && validItinerary(data);
      }
      allow read: if true;
      function departureSetupComplete() {
        let travel = get(/databases/$(database)/documents/Trips/indonesia-2027/people/$(request.auth.uid)/private/travel).data;
        return travel.city is string && travel.city.trim().size() > 0
          && travel.departureAirports is list && travel.departureAirports.size() > 0;
      }
      allow create: if signedIn() && departureSetupComplete() && validFlight();
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // Activity is visible only through the Firebase console to project admins.
    match /Trips/indonesia-2027/guestEntries/{entryId} {
      allow create: if request.resource.data.keys().hasAll(['enteredAt'])
        && request.resource.data.keys().hasOnly(['enteredAt'])
        && request.resource.data.enteredAt == request.time;
    }

    match /Trips/indonesia-2027/people/{uid}/private/activity {
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasAll(['lastSignedInAt'])
        && request.resource.data.keys().hasOnly(['lastSignedInAt'])
        && request.resource.data.lastSignedInAt == request.time;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
